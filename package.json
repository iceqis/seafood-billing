{
  "name": "seafood-billing",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "test": "npm run test:frontend && npm run test:worker && npm run test:config",
    "test:frontend": "vitest run --config vitest.config.js",
    "test:worker": "vitest run --config vitest.worker.config.js",
    "test:config": "node --test tests/config/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm test && npm run test:e2e",
    "dev": "http-server . -p 4173 -c-1",
    "deploy:worker": "wrangler deploy",
    "build:pages": "node scripts/build-pages.js"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.21",
    "@playwright/test": "^1.62.1",
    "http-server": "^14.1.1",
    "jsdom": "^29.0.1",
    "vitest": "3.2.7",
    "wrangler": "^4.125.0"
  }
}
